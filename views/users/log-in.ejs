<section class="flex flex-col items-center justify-center py-12 px-4">
    <div class="card w-full max-w-md bg-base-100 shadow-2xl border border-base-200">
        <div class="card-body">
            <h2 class="text-2xl font-bold  text-center mb-6">Welcome Back</h2>

            <form id="login-form" class="space-y-4 p">
                <div>
                    <label class="label"></label>
                    <input id="login-email" type="email" name="email" placeholder="email@example.com"
                        class="input border border-black" required />
                </div>

                <div>
                    <label class="label"></label>
                    <input id="login-password" type="password" name="password" placeholder="password"
                        class="input border border-black" required />
                </div>
                <br>
                <div>
                    <label class="label"></label>
                    <input id="role-customer" type="radio" name="radio-1" class="radio" checked="checked" />Customer
                    <label class="label"></label>
                    <input id="role-data-clerk" type="radio" name="radio-1" class="radio" /> Data Clerk
                </div>
                <div class="flex justify-center mt-6">
                    <button id="login-submit" type="submit"
                        class="btn bg-main border-none  text-black font-bold shadow-md hover:bg-opacity-300">
                        Log in
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>