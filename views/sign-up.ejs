<section class="flex flex-col items-center justify-center py-12 px-4">
    <div class="card w-full max-w-md bg-base-100 shadow-2xl border border-base-200">
        <div class="card-body">
            <h2 class="text-2xl font-bold  text-center mb-6">Create a Hope's account</h2>
            
            <form class="space-y-4 p">
                <div>
                    <label class="label"></label>
                    <input type="text" name="name" placeholder="First Name" class="input input-bordered border border-black" required />
                </div>

                <div>
                    <label class="label"></label>
                    <input type="text" name="name" placeholder="Last Name" class="input input-bordered border border-black" required />
                </div>

                <div>
                    <label class="label"></label>
                    <input type="email" name="email" placeholder="email@example.com" class="input input-bordered border border-black" required />
                </div>

                <div>
                    <label class="label"></label>
                    <input type="password" name="password" placeholder="password" class="input input-bordered border border-black" required />
                </div>

                <div class="flex justify-center mt-6">
                    <button type="submit" class="btn bg-main border-none  text-black font-bold shadow-md hover:bg-opacity-300">
                        Create 
                    </button>
                </div>
            </form>

            <p class="text-center mt-4 text-sm">
                Already have an account? <a href="/log-in" class="link text-black font-bold">Login here</a>
            </p>
        </div>
    </div>
</section>