<section class="max-w-7xl mx-auto py-12 px-4 sm:px-8">

    <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tighter mb-4">On The Menu</h1>
        <p class="text-lg opacity-80 max-w-xl mx-auto">
            Between classic, healthy and vegetarian meals kits. <strong>Free delivery for orders above 50$ !! </strong>
        </p>
    </div>

    <% if (categoryMealKits && categoryMealKits.length > 0) { %>
        <% categoryMealKits.forEach(category=> { %>

            <div class="mb-12">
                <h2 class="text-3xl font-black uppercase tracking-tight mb-6 text-center">
                    <%= category.categoryName %>
                </h2>

                <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-8">
                    <% category.mealkits.forEach(meal=> { %>
                        <%- include('../partials/mealkit.ejs', { meal: meal }) %>
                    <% }) %>
                </div>
            </div>

            <% }) %>
                <% } else { %>
                    <div class="text-center py-20 bg-base-200 rounded-3xl">
                        <p class="text-2xl font-bold opacity-50">No meals for this week</p>
                    </div>
                    <% } %>

</section>